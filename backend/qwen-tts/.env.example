TTS_DOMAIN=tts.minallo.de
ACME_EMAIL=admin@minallo.de
ENVIRONMENT=production

# Must exactly match QWEN_TTS_INTERNAL_SECRET in backend/python-ai's .env —
# generate with: openssl rand -hex 32
QWEN_TTS_INTERNAL_SECRET=

QWEN_TTS_MODEL_ID=Qwen/Qwen3-TTS-12Hz-0.6B-Base
QWEN_TTS_DEFAULT_VOICE=minallo-de-1
QWEN_TTS_MAX_TEXT_LENGTH=2000
QWEN_TTS_MAX_CONCURRENCY=2
QWEN_TTS_GENERATE_TIMEOUT_S=120
