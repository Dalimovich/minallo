{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2 h3
	}
}

{$TTS_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		-Server
	}

	reverse_proxy tts:8090 {
		transport http {
			response_header_timeout 150s
		}
	}

	log {
		output stdout
		format json
	}
}
